    "book_steady_hand": { "name": "The Steady Hand", "cat": "books", "teaches": "lockpicking", "weight": 1, "value": 40, "text": ["A lock is a small argument, the old picker said. You do not win it by shouting.", "Listen to the pins. Turn the cylinder only when the pick has stopped trembling. If it trembles, back off and try a hair to the left. The lock will tell you; it always wants to be opened, it only wants to be asked properly."], "mesh": { "kind": "book", "color": "#3a2a4a" } },
    "book_first_flame": { "name": "Ashes of the First Flame", "cat": "books", "teaches": "destruction", "weight": 1, "value": 45, "text": ["Fire is a memory of the sun. Every flame you call is the world remembering a morning.", "Hold the hand open. Do not grip the heat; let it pass through you as a thought passes, and it will go where you look."], "mesh": { "kind": "book", "color": "#6a2418" } },
    "book_barrow_bells": { "name": "Of Barrows and Bells", "cat": "books", "weight": 1, "value": 15, "text": ["The old folk of the valley buried their dead with three signs over the door: the Moon, the Bell and the Eye. A barrow is opened by showing the signs in the order the dead were sung to sleep: first the Moon that watches, then the Bell that calls, last the Eye that remembers.", "It is said that under Hollowford there is a door that remembers a word, and that the word is older than the town."], "mesh": { "kind": "book", "color": "#2a3a2a" } },
    "book_hollowford": { "name": "A Short History of Hollowford", "cat": "books", "weight": 1, "value": 10, "text": ["Hollowford was a ford before it was a town, and a hollow before it was a ford. The first settlers found the barrow already old, and built the inn with its back to it, out of respect or out of fear.", "The moon has hung full over the town for nine nights now. Nobody remembers when it last set. Nobody, if you ask them, remembers very much at all."], "mesh": { "kind": "book", "color": "#5a3a1a" } },

